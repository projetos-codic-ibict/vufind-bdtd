<?php
  // BDTD: baseado em bootstrap5/templates/record/cite.phtml (VuFind 11.1); sem título na
  // página nem botões de copiar, rótulos e nota do Zotero como no legado.
  // Set up breadcrumbs:
  $this->breadcrumbs()->reset();
  if ($url = $this->searchMemory()->getLastSearchUrl()) {
    $this->breadcrumbs()->add($this->translate('Search'), $url);
  }
  $this->breadcrumbs()->add(...$this->recordLinker()->getBreadcrumbParams($this->driver))
    ->add($this->translate('Record Citations'), active: true);

  // Collect citation data:
  $helper = $this->citation($this->driver);
  $citations = [];
  foreach ($this->driver->getCitationFormats() as $format) {
    $citations[$format] = $helper->getCitation($format);
  }
?>
<?php $this->headTitle($this->translate('Record Citations')); // BDTD: só o título da aba ?>
<?php if (count($citations) == 0): ?>
  <?=$this->transEsc('No citations are available for this record')?>
<?php else: ?>
  <?php foreach ($citations as $format => $citation): ?>
    <?php
      // BDTD: rótulo curto ("Referência de acordo com a norma APA"), como no legado
      $caption = $this->translate($format . ' Citation');
    ?>
    <strong><?=$this->escapeHtml($caption)?></strong>
    <p class="text-left">
      <?=$citation?>
    </p>
  <?php endforeach; ?>
  <?php /* BDTD: nota do legado recomendando o Zotero */ ?>
  <div class="text-muted text-center">
    <?=$this->transEsc('ABNT Citation Note')?>
    <a href="https://zenodo.org/record/6376312" target="_blank" rel="noopener noreferrer">Zotero</a>
    <?=$this->transEsc('ABNT Citation Note2')?>
  </div>
<?php endif; ?>
